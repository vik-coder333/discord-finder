# Copy this file to ".env" and fill in your values, then restart the server.
# The site works fine WITHOUT any of these — they just unlock extra features.

# ---- Payments (Stripe) ----
# Get these free at https://dashboard.stripe.com/apikeys
# Use the TEST keys (start with sk_test_) while trying things out — no real money.
# Swap to LIVE keys (sk_live_) when you're ready to charge real customers.
STRIPE_SECRET_KEY=

# Optional but recommended for production. Create a webhook endpoint in Stripe
# pointing to  https://YOURSITE/api/webhook  and listen for
# "checkout.session.completed". Stripe gives you a signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# ---- Admin panel ----
# Any long random string. Visit /admin.html and paste it in to moderate servers.
ADMIN_KEY=

# ---- Port (optional) ----
# Hosts set this automatically; leave blank locally to use 4000.
PORT=
